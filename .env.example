# Copy to .env and fill in. The three Azure OpenAI values are required.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=

# Deployment names (the names you gave the deployments in Azure, not the model names)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional: minimal | low | medium | high. Leave empty to use the deployment default.
LLM_REASONING_EFFORT=

# Optional
WEB_PORT=8080
POSTGRES_PASSWORD=medication_doc_verifier
JWT_SECRET=change-me-to-a-long-random-string
DUPLICATE_WINDOW_SECONDS=300
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-1
